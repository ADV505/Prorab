<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:generation="using:ActiproSoftware.UI.Avalonia.Themes.Generation"
             xmlns:home="using:Prorab.UI.Modules.Home"
             xmlns:crews="using:Prorab.UI.Modules.Crews"
             xmlns:ref="using:Prorab.UI.Modules.ReferenceBooks"
             xmlns:sites="using:Prorab.UI.Modules.Sites"
             xmlns:wt="using:Prorab.UI.Modules.WorkTypes"
             xmlns:w="using:Prorab.UI.Modules.Workers"
             xmlns:worker="using:Prorab.UI.Modules.Workers"
             x:Class="Prorab.UI.App">
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type home:HomeViewModel}">
      <home:HomeView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type crews:CrewsViewModel}">
      <crews:CrewsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type ref:ReferenceBooksViewModel}">
      <ref:ReferenceBooksView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type sites:SitesViewModel}">
      <sites:SitesView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type wt:WorkTypesViewModel}">
      <wt:WorkTypesView/>
    </DataTemplate>
      <DataTemplate DataType="w:WorkersViewModel">
    <worker:WorkersView/>
</DataTemplate>

  </Application.DataTemplates>


  <Application.Resources>
  <ResourceDictionary>
    <ResourceDictionary.ThemeDictionaries>

      <ResourceDictionary x:Key="Light">
        <!-- Акцент: палитра Blue-рампы Actipro -->
        <SolidColorBrush x:Key="AccentBrush"           Color="#2E7CD6"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentSoftBrush"       Color="#E3F0FB"/>
        <SolidColorBrush x:Key="AccentTextBrush"       Color="#1B5FA8"/>
        <!-- Семантика -->
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4F5EA"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#1E7A43"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF3E2"/>
        <SolidColorBrush x:Key="WarningTextBrush" Color="#9A5F00"/>
        <SolidColorBrush x:Key="DangerSoftBrush"  Color="#FCE9E9"/>
        <SolidColorBrush x:Key="DangerTextBrush"  Color="#B02A2A"/>
        <SolidColorBrush x:Key="MutedTextBrush"   Color="#6B7280"/>
        <!-- Фоны и рамки -->
        <SolidColorBrush x:Key="PageBackgroundBrush"   Color="#F6F7F9"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush"       Color="#E4E7EC"/>
      </ResourceDictionary>

      <ResourceDictionary x:Key="Dark">
        <SolidColorBrush x:Key="AccentBrush"           Color="#4C9AFF"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0B2239"/>
        <SolidColorBrush x:Key="AccentSoftBrush"       Color="#143A5A"/>
        <SolidColorBrush x:Key="AccentTextBrush"       Color="#8FC5FF"/>
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1B3A28"/>
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#7FD99B"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#3F2E10"/>
        <SolidColorBrush x:Key="WarningTextBrush" Color="#F2C063"/>
        <SolidColorBrush x:Key="DangerSoftBrush"  Color="#421418"/>
        <SolidColorBrush x:Key="DangerTextBrush"  Color="#FF8E8E"/>
        <SolidColorBrush x:Key="MutedTextBrush"   Color="#9AA3AE"/>
        <SolidColorBrush x:Key="PageBackgroundBrush"    Color="#1C1C1F"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#242428"/>
        <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#2A2A2E"/>
        <SolidColorBrush x:Key="CardBorderBrush"        Color="#3A3A40"/>
      </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
  </ResourceDictionary>
</Application.Resources>



  <Application.Styles>
    <actipro:ModernTheme Includes="NativeDataGrid">
  <actipro:ModernTheme.Definition>
    <generation:ThemeDefinition AccentColorRampName="Blue"/>
  </actipro:ModernTheme.Definition>
</actipro:ModernTheme>

      <materialIcons:MaterialIconStyles />

      <StyleInclude Source="avares://Prorab.UI/Themes/Cards.axaml"/>

    <!-- Убирает ворчание Rider про неизвестные классы стилей -->
    <StyleInclude Source="avares://ActiproSoftware.Avalonia.Shared/Themes/StyleClassStubs.axaml"/>

    <!-- Карточка: фон, рамка, тень -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BoxShadow" Value="0 1 2 0 #0D000000, 0 4 14 0 #14000000"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Пилюля-бейдж -->
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style Selector="Border.pill TextBlock">
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Типографика -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    </Style>
  </Application.Styles>
</Application>
