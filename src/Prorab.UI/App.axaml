<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Prorab.UI.App"
             xmlns:home="using:Prorab.UI.Modules.Home">
  <Application.DataTemplates>
    <DataTemplate DataType="home:HomeViewModel">
      <home:HomeView/>
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme/>
  </Application.Styles>
</Application>
