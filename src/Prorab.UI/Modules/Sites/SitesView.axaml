<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prorab.UI.Modules.Sites"
             xmlns:core="using:Prorab.Core.Models"
             x:Class="Prorab.UI.Modules.Sites.SitesView"
             x:DataType="vm:SitesViewModel">

    <UserControl.Styles>
        <!-- Стили для бейджа статуса -->
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#2E4CAF50"/>
            <Setter Property="TextBlock.Foreground" Value="#2E7D32"/>
        </Style>
        <Style Selector="Border.badge.completed">
            <Setter Property="Background" Value="#2EFFB300"/>
            <Setter Property="TextBlock.Foreground" Value="#9A7D00"/>
        </Style>
        <!-- Опционально: стиль для "без срока" (нейтральный серый), если захочешь заменить зеленый -->
        <!--
        <Style Selector="Border.badge.nodate">
            <Setter Property="Background" Value="#2E9E9E9E"/>
            <Setter Property="TextBlock.Foreground" Value="#000000"/>
        </Style>
        -->
    </UserControl.Styles>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,12">
            <TextBlock Text="Объекты" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="＋ Добавить" Click="OnAdd" HorizontalAlignment="Right" Padding="16,6"/>
        </DockPanel>

        <ScrollViewer>
            <StackPanel Spacing="12">
                <!-- Поиск -->
                <TextBox PlaceholderText="Поиск по названию или адресу…"
                         Text="{Binding SearchText, Mode=TwoWay}"/>

                <!-- Сообщение, если активных объектов нет -->
                <TextBlock Text="Нет объектов — добавьте первый."
                           IsVisible="{Binding !HasSites}" Opacity="0.6"/>

                <!-- Активные объекты -->
                <ItemsControl ItemsSource="{Binding Sites}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:Site">
                            <Border Width="330" Margin="0,0,12,12" Padding="16"
                                    CornerRadius="10"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <!-- Заголовок и Бейдж -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <!-- Один Border вместо двух перекрывающихся -->
                                        <Border Grid.Column="1" Classes="badge" Classes.completed="{Binding IsCompleted}"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="11"/>
                                        </Border>
                                    </Grid>

                                    <!-- Адрес -->
                                    <TextBlock Text="{Binding Address}" Opacity="0.7" FontSize="12"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding Address, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                    <!-- Разделитель и Инфо (показываются только если есть данные) -->
                                    <Separator Margin="0,2" IsVisible="{Binding HasInfo}"/>
                                    <TextBlock Text="{Binding Info}" FontSize="12" Opacity="0.8"
                                               IsVisible="{Binding HasInfo}"/>

                                    <!-- Кнопки (выровнены строго вправо) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                Spacing="8" Margin="0,6,0,0">
                                        <Button Content="Изменить" Click="OnEdit" CommandParameter="{Binding}" Padding="12,4"/>
                                        <Button Content="Архивировать" Click="OnArchive" CommandParameter="{Binding}" Padding="12,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Архивные объекты (Expander) -->
                <Expander IsVisible="{Binding HasArchivedSites}" IsExpanded="False">
                    <Expander.Header>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding ArchivedSites.Count, StringFormat='Архивные объекты ({0})'}"/>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding ArchivedSites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:Site">
                                <Border Width="330" Margin="0,0,12,12" Padding="16" CornerRadius="10" Opacity="0.7"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Address}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>
                                        <!-- В архиве Info тоже можно показать, если нужно, или оставить только кнопки -->
                                        <TextBlock Text="{Binding Info}" FontSize="12" Opacity="0.7"
                                                   IsVisible="{Binding HasInfo}" Margin="0,0,0,6"/>
                                        
                                        <Button Content="Восстановить" Click="OnRestore" CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" Padding="12,4" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
