<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Prorab.UI.Modules.WorkTypes"
             xmlns:core="using:Prorab.Core.Models"
             x:Class="Prorab.UI.Modules.WorkTypes.WorkTypesView"
             x:DataType="vm:WorkTypesViewModel">

  <Panel Background="{atom:SharedTokenResource ColorBgLayout}">
    <StackPanel Margin="24" Spacing="12">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Виды работ" FontSize="24" FontWeight="SemiBold"/>
        <atom:Button ButtonType="Primary" Grid.Column="1" Content="Добавить вид работ"
                Classes="Primary" Click="OnAdd"/>
      </Grid>

      <atom:DataGrid 
          ItemsSource="{Binding WorkTypesSource}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserSortColumns="True"
                     CanUserResizeColumns="True"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     SelectionMode="Single">
        <atom:DataGrid.Columns>

          <atom:DataGridTextColumn x:DataType="core:WorkType"
                                   Header="Название"                                    
                                   Binding="{Binding Name}"
                                   Width="3*"/>

          <atom:DataGridTextColumn x:DataType="core:WorkType"
              Header="Ед. изм."
                                   Binding="{Binding Unit}"
                                   Width="120"/>

          <atom:DataGridTextColumn x:DataType="core:WorkType"
              Header="Базовая цена"
                                   Binding="{Binding BasePrice, StringFormat='{}{0:0.##}'}"
                                   Width="160"/>

          <atom:DataGridTemplateColumn Width="220">
            <atom:DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="core:WorkType">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Left">
                  <atom:Button Content="Изменить"
                          Classes="Primary"
                          Click="OnEdit"
                          CommandParameter="{Binding}"/>
                  <!--<Button Content="Архивировать"
                          Click="OnArchive"
                          CommandParameter="{Binding}"/>-->
                </StackPanel>
              </DataTemplate>
            </atom:DataGridTemplateColumn.CellTemplate>
          </atom:DataGridTemplateColumn>

        </atom:DataGrid.Columns>
      </atom:DataGrid>
    </StackPanel>
  </Panel>
</UserControl>
