<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:vm="using:Prorab.UI.Modules.WorkTypes"
             xmlns:core="using:Prorab.Core.Models"
             x:Class="Prorab.UI.Modules.WorkTypes.WorkTypesView"
             x:DataType="vm:WorkTypesViewModel">

  <Panel Background="{atom:SharedTokenResource ColorBgLayout}">
    <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="12">

      <!-- Шапка -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
        <atom:TextBlock Text="Виды работ" FontSize="24" FontWeight="SemiBold"
                        VerticalAlignment="Center"/>
        <atom:TextBox Grid.Column="1" Width="280"
                      PlaceholderText="начни вводить слово"
                      Text="{Binding SearchText}"
                      IsAllowClear="True"/>
        <atom:Button Grid.Column="2" Margin="12,0,0,0"
                     ButtonType="Primary"
                     Content="Добавить вид работ"
                     Click="OnAdd"/>
      </Grid>

      <!-- Таблица: забирает всё оставшееся место, скроллит сама -->
      <atom:DataGrid Grid.Row="1"
                     ItemsSource="{Binding WorkTypesSource}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     CanUserSortColumns="True"
                     CanUserResizeColumns="True"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     SelectionMode="Single">
        <atom:DataGrid.Columns>

          <atom:DataGridTextColumn x:DataType="core:WorkType"
                                   Header="Название"
                                   Binding="{Binding Name}"
                                   Width="*"/>

          <atom:DataGridTextColumn x:DataType="core:WorkType"
                                   Header="Ед. изм."
                                   Binding="{Binding Unit}"
                                   Width="120"/>

          <atom:DataGridTextColumn x:DataType="core:WorkType"
                                   Header="Базовая цена"
                                   Binding="{Binding BasePrice, StringFormat='{}{0:0.##}'}"
                                   Width="160"/>

          <atom:DataGridTemplateColumn Width="180">
            <atom:DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="core:WorkType">
                <atom:Button Content="Изменить"
                             Click="OnEdit"
                             CommandParameter="{Binding}"/>
              </DataTemplate>
            </atom:DataGridTemplateColumn.CellTemplate>
          </atom:DataGridTemplateColumn>

        </atom:DataGrid.Columns>
      </atom:DataGrid>
    </Grid>
  </Panel>
</UserControl>
