<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="using:Prorab.UI.Navigation"
             xmlns:vm="using:Prorab.UI.Modules.Home"
             x:Class="Prorab.UI.Modules.Home.HomeView"
             x:DataType="vm:HomeViewModel">

  <Panel Background="{DynamicResource PageBackgroundBrush}">
    <ScrollViewer>
      <StackPanel Margin="32,28" Spacing="20">

        <TextBlock Classes="h1" Text="{Binding Greeting}"/>

        <StackPanel Orientation="Horizontal" Spacing="16">

          <!-- Объекты -->
          <Border Classes="card" Width="320" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <Border Width="42" Height="42" CornerRadius="12"
                      Background="{DynamicResource AccentSoftBrush}"
                      HorizontalAlignment="Left">
                <PathIcon Width="22" Height="22"
                          Foreground="{DynamicResource AccentBrush}"
                          Data="{x:Static nav:Icons.Home}"/>
              </Border>
              <TextBlock Classes="h2" Text="Объекты"/>
              <!--<TextBlock Classes="stat" Text="{Binding ActiveSites}"/>-->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="stat" Background="{DynamicResource SuccessSoftBrush}">
                  <TextBlock Foreground="{DynamicResource SuccessTextBrush}"
                             Text="{Binding ActiveSites, StringFormat='Действующих: {0}'}"/>
                </Border>
                <Border Classes="stat" Background="{DynamicResource DangerSoftBrush}"
                        IsVisible="{Binding HasOverdue}">
                  <TextBlock Foreground="{DynamicResource DangerTextBrush}"
                             Text="{Binding OverdueSites, StringFormat='Просрочено: {0}'}"/>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Сумма действующих контрактов -->
          <Border Classes="card" Width="320" VerticalAlignment="Top">
            <StackPanel Spacing="10">
              <Border Width="42" Height="42" CornerRadius="12"
                      Background="{DynamicResource AccentSoftBrush}"
                      HorizontalAlignment="Left">
                <PathIcon Width="22" Height="22"
                          Foreground="{DynamicResource AccentBrush}"
                          Data="{x:Static nav:Icons.Database}"/>
              </Border>
              <TextBlock Classes="h2" Text="Сумма действующих контрактов"
                         TextWrapping="Wrap"/>
              <TextBlock Classes="stat"
                         Text="{Binding ActiveAmount, StringFormat='{}{0:N0} руб.'}"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
