<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prorab.UI.Modules.Home"
             xmlns:atom="https://atomui.net"
             x:Class="Prorab.UI.Modules.Home.HomeView"
             x:DataType="vm:HomeViewModel">

  <Panel Background="{atom:SharedTokenResource ColorBgLayout}">
    <StackPanel Margin="24" Spacing="16">

      <TextBlock Text="{Binding Greeting}" FontSize="24" FontWeight="SemiBold"/>

      <!-- Карточка «Объекты» -->
      <Border Width="280" Padding="20" CornerRadius="8"
              Background="{atom:SharedTokenResource ColorBgContainer}">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <atom:TextBlock Text="Объекты" FontSize="16" FontWeight="SemiBold"/>
            <atom:Tag TagColor="red" Variant="Filled"
                      IsVisible="{Binding HasOverdue}"
                      Text="{Binding OverdueSites, StringFormat='Просрочено: {0}'}"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <atom:Tag TagColor="green" Variant="Filled"
                      Text="{Binding ActiveSites, StringFormat='Действующих: {0}'}"/>
            <atom:Tag TagColor="orange" Variant="Filled"
                      IsVisible="{Binding HasOverdue}"
                      Text="Сроки вышли"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </Panel>
</UserControl>
