<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prorab.UI.Modules.WorkOrders"
             x:Class="Prorab.UI.Modules.WorkOrders.WorkOrdersView"
             x:DataType="vm:WorkOrdersViewModel"
             Loaded="OnViewLoaded">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="Наряды" FontSize="20" FontWeight="SemiBold"/>
      <Button Grid.Column="1" Classes="theme-solid accent" Content="+ Новый наряд" Click="OnNew"/>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Orders}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OrderRow">
            <Border Padding="10" Margin="0,4" CornerRadius="6" BorderThickness="1"
                    BorderBrush="#30FFFFFF">
             <Grid ColumnDefinitions="90,100,1*,1*,90,80,90,90,Auto,Auto,Auto" ColumnSpacing="10">
  <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center"/>
  <TextBlock Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center" Opacity="0.85"/>
  <TextBlock Grid.Column="2" Text="{Binding CrewName}" VerticalAlignment="Center"/>
  <TextBlock Grid.Column="3" Text="{Binding SiteName}" VerticalAlignment="Center"/>
  <TextBlock Grid.Column="4" Text="{Binding TotalText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
  <TextBlock Grid.Column="5" Text="{Binding OfficialText}" VerticalAlignment="Center"
             HorizontalAlignment="Right" Opacity="0.85"/>
  <TextBlock Grid.Column="6" Text="{Binding PaidText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
  <TextBlock Grid.Column="7" Text="{Binding RemainingText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
  <Button Grid.Column="8" Classes="theme-outline" Content="Открыть" Click="OnOpen" CommandParameter="{Binding}"/>
  <Button Grid.Column="9" Classes="theme-outline" Content="Выплаты" Click="OnPayments" CommandParameter="{Binding}"/>
  <Button Grid.Column="10" Classes="theme-outline" Content="Удалить" Click="OnDelete" CommandParameter="{Binding}"/>
</Grid>

            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Opacity="0.85"/>
  </Grid>
</UserControl>
