<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prorab.UI.Modules.Workers"
             xmlns:core="using:Prorab.Core.Models"
             x:Class="Prorab.UI.Modules.Workers.WorkersView"
             x:DataType="vm:WorkersViewModel">

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,4,0,12" Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Работники" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="＋ Добавить" Click="OnAdd" HorizontalAlignment="Right" Padding="16,6"/>
      </Grid>
      <TextBox PlaceholderText="Поиск по ФИО или телефону…" Text="{Binding SearchText, Mode=TwoWay}"/>
    </StackPanel>

    <Grid RowDefinitions="*,Auto,Auto" RowSpacing="8">

      <!-- Активные работники -->
            <DataGrid ItemsSource="{Binding Workers}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                SelectionMode="Single"
                FrozenColumnCount="1"
                x:CompileBindings="False"
                DoubleTapped="OnRowDoubleTapped">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="240" FontWeight="SemiBold"/>

          <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120"/>
          <DataGridTextColumn Header="Оформление" Binding="{Binding ContractText}" Width="250"/>
          <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneText}" Width="140"/>
          <DataGridTextColumn Header="Ставка" Binding="{Binding RateText}" Width="90"/>
          <DataGridTextColumn Header="СНИЛС" Binding="{Binding SnilsText}" Width="130"/>
          <DataGridTextColumn Header="ИНН" Binding="{Binding InnText}" Width="130"/>
          <DataGridTextColumn Header="Паспорт" Binding="{Binding PassportText}" Width="150"/>
          <DataGridTemplateColumn Header="Действия" Width="320">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="core:Worker">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2"
                            HorizontalAlignment="Left">
                  <Button Content="Изменить" Click="OnEdit" CommandParameter="{Binding}" Padding="10,4"/>
                  <Button Content="Сделать договор" Click="OnMakeContract" CommandParameter="{Binding}"
                          Padding="10,4" IsVisible="{Binding CanMakeContract}"/>
                  <Button Content="Архивировать" Click="OnArchive" CommandParameter="{Binding}" Padding="10,4"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Row="0" Text="Нет работников — добавьте первого."
                 IsVisible="{Binding !HasWorkers}" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <TextBlock Grid.Row="1" Text="{Binding StatusText}" Opacity="0.9"/>

      <!-- Архивные -->
      <Expander Grid.Row="2" IsVisible="{Binding HasArchivedWorkers}" IsExpanded="False">
        <Expander.Header>
          <TextBlock FontWeight="SemiBold"
                     Text="{Binding ArchivedWorkers.Count, StringFormat='Архивные работники ({0})'}"/>
        </Expander.Header>
                <DataGrid ItemsSource="{Binding ArchivedWorkers}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  FrozenColumnCount="1"
                  x:CompileBindings="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="240" FontWeight="SemiBold"/>

            <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120"/>
            <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneText}" Width="150"/>
            <DataGridTextColumn Header="Инфо" Binding="{Binding Info}" Width="1*"/>
            <DataGridTemplateColumn Header="Действия" Width="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="core:Worker">
                  <Button Content="Восстановить" Click="OnRestore" CommandParameter="{Binding}"
                          HorizontalAlignment="Left" Margin="4,2" Padding="12,4"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Expander>

    </Grid>
  </DockPanel>
</UserControl>
