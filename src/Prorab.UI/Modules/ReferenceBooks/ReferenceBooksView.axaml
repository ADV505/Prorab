<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="using:AtomUI.Icons.AntDesign"
             xmlns:vm="using:Prorab.UI.Modules.ReferenceBooks"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:atom="https://atomui.net"
             x:Class="Prorab.UI.Modules.ReferenceBooks.ReferenceBooksView"
             x:DataType="vm:ReferenceBooksViewModel">

  <Panel >
      
    <!-- Хаб: плитки -->
    <ScrollViewer IsVisible="{Binding IsHome}">
      <StackPanel Margin="24,24,24,5" Spacing="12">
        <TextBlock Margin ="18,0,0,0" Text="Справочники" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Margin ="18,0,0,0" Text="Объекты, Субподрядчики, Прайс работ" FontSize="14"/>
        <ItemsControl ItemsSource="{Binding Books}" >
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <atom:Button Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}"
                      CommandParameter="{Binding Id}"
                      HorizontalContentAlignment="Stretch" Padding="-1" Margin="12" >
               
 <atom:Card IsHoverable="True" MinWidth="300"  HorizontalAlignment="Left">
        <atom:CardMetaContent Header="{Binding Title}">
            <atom:CardMetaContent.Avatar>
                <atom:Avatar Icon="{Binding Icon, Converter={StaticResource KindToIcon}}"/>
            </atom:CardMetaContent.Avatar>
            <StackPanel Orientation="Vertical" Spacing="3">
                <atom:TextBlock Text="{Binding Description}" />
               
            </StackPanel>
        </atom:CardMetaContent>
        
    </atom:Card>
              </atom:Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Открытый справочник -->
    <DockPanel IsVisible="{Binding !IsHome}" >
      <atom:Button DockPanel.Dock="Top" Command="{Binding BackCommand}" 
              Content="← Все справочники" HorizontalAlignment="Left" Margin="16,24,5,5"/>
      <ContentControl Content="{Binding Current}"/>
    </DockPanel>
  </Panel>
</UserControl>
