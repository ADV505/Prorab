<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Prorab.UI.Modules.ReferenceBooks"
             x:Class="Prorab.UI.Modules.ReferenceBooks.ReferenceBooksView"
             x:DataType="vm:ReferenceBooksViewModel">

  <Panel>
    <!-- Хаб: плитки -->
    <ScrollViewer IsVisible="{Binding IsHome}">
      <StackPanel Margin="24" Spacing="12">
        <TextBlock Margin="18,0,0,0" Text="Справочники" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Margin="18,0,0,0" Text="Объекты, Субподрядчики, Прайс работ" FontSize="14" Opacity="0.7"/>

        <ItemsControl ItemsSource="{Binding Books}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding $parent[ItemsControl].DataContext.OpenCommand}"
                      CommandParameter="{Binding Id}"
                      HorizontalAlignment="Left" Margin="12" Padding="0">
                <Border MinWidth="300" Padding="16" CornerRadius="8"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="#4E7F9A" VerticalAlignment="Top">
                      <PathIcon Width="20" Height="20" Foreground="White"
                                Data="{Binding Icon, Converter={StaticResource IconPath}}"/>
                    </Border>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Description}" Opacity="0.7"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Открытый справочник -->
    <DockPanel IsVisible="{Binding !IsHome}">
      <Button DockPanel.Dock="Top" Command="{Binding BackCommand}"
              Content="← Все справочники" HorizontalAlignment="Left" Margin="16,24,5,5"/>
      <ContentControl Content="{Binding Current}"/>
    </DockPanel>
  </Panel>
</UserControl>
