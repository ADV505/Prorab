<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Prorab.UI.Shell"
        xmlns:nav="using:Prorab.UI.Navigation"
        x:Class="Prorab.UI.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Icon="avares://Prorab.UI/Assets/prorab_icon.png"
        Title="Прораб" Width="1100" Height="700"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- Компактные пункты меню -->
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <!-- В свёрнутом сайдбаре прячем названия, иконку центрируем -->
    <Style Selector="ListBox.collapsed TextBlock.navTitle">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ListBox.collapsed PathIcon">
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="Auto,*">
    <Border Grid.Column="0" x:Name="Sidebar" Width="220"
            Background="#F5F6F8" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,6,10">
          <TextBlock x:Name="AppTitle" Text="Прораб" FontSize="18"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="ToggleButton" Grid.Column="1" Width="36" Height="36" Padding="0"
                  Background="Transparent" BorderThickness="0"
                  Click="HandleToggleSidebarClick"/>
        </Grid>
        <ListBox x:Name="NavList" Grid.Row="1" Classes="nav"
                 Margin="6,0,6,8" Background="Transparent"
                 ItemsSource="{Binding Modules}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="nav:INavigationModule">
              <Panel Height="34" Margin="2">
                <PathIcon Width="20" Height="20" HorizontalAlignment="Left"
                          Data="{Binding Icon, Converter={StaticResource IconPath}}"/>
                <TextBlock Classes="navTitle" Text="{Binding Title}"
                           Margin="34,0,0,0" VerticalAlignment="Center"/>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding Current}" Background="#F5F6F8"/>
  </Grid>
</Window>
